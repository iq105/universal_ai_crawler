# ============ LLM（OpenAI 兼容接口，可接 DeepSeek/通义/GLM 等）============
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0

# ============ 数据库 ============
# 默认 SQLite（开箱即用，无需安装任何数据库）
DATABASE_URL=sqlite+aiosqlite:///./crawler.db
# 有 PostgreSQL 时改用（需先创建库：CREATE DATABASE universal_crawler;）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/universal_crawler

# ============ Redis（可选，未配置自动降级为仅 DB）============
REDIS_URL=

# ============ 爬虫 ============
# 单任务最大翻页数
MAX_PAGES=5
# 提取失败/校验失败后重新生成方案的最大次数
MAX_EXTRACT_RETRIES=2
# 浏览器有头/无头：默认 false=有头（人工介入可直接操作弹出窗口）；服务器环境可改 true
HEADLESS=false
# 浏览器隐身（清除 webdriver 标记、伪造指纹）
STEALTH_ENABLED=true
# 会话持久化路径（留空=不持久化登录态；建议 artifacts/storage/state.json）
STORAGE_STATE_PATH=
# Agent 单任务最大行动步数
MAX_STEPS=30
# 媒体下载目录
MEDIA_DIR=artifacts/media
# ffmpeg 路径（下载 m3u8/合并音视频需要，留空则探测 PATH）
FFMPEG_PATH=
# 强制在某节点触发人工介入（用于测试 HITL 流程，留空=不触发）
# 可选值: page_load
FORCE_INTERRUPT_AT=

# ============ 反封禁 / 代理池 ============
# 代理池：逗号分隔，支持 socks5/http/https，如：
# PROXY_LIST=socks5://127.0.0.1:1080,http://user:pass@host:port
PROXY_LIST=
# 限流/封禁后单次导航最大重试次数
ANTI_BAN_MAX_RETRIES=3

# ============ 浏览器服务（Node.js Playwright 微服务）============
BROWSER_SERVICE_URL=http://127.0.0.1:8765
# 后端启动时自动拉起 browser-service（false 则需手动 npm start 启动）
BROWSER_SERVICE_AUTO_START=true
# browser-service 共享鉴权 token（留空=不启用鉴权；生产环境建议设置）
SERVICE_TOKEN=
# 地域画像：locale/timezone 必须一致，且尽量与代理出口 IP 匹配
# 做海外站或挂国外代理时覆盖，避免【中文 locale + 国外 IP】的地域矛盾被识别
LOCALE=zh-CN
TIMEZONE=Asia/Shanghai

# ============ 服务 ============
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
